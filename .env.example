# ==============================================================================
# Faculty Self-Assessment (PBAS) — deployment settings
# ==============================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the values for the target you want:
#       free  ->  section A + B          then run:  sh scripts/deploy-free.sh
#       AWS   ->  section A + C          then run:  sh scripts/deploy-aws.sh
# 3. Never commit .env (it is already in .gitignore).
#
# Format: KEY=value, one per line. Quotes are optional and are stripped.
# Values are read as plain text (nothing is executed), so characters like
# & ? $ in a database URL are safe.
# ==============================================================================


# ------------------------------------------------------------------------------
# A. SHARED (both scripts)
# ------------------------------------------------------------------------------

# Short lowercase name used for every cloud resource (letters, digits, dashes).
APP_NAME=facultyform

# PostgreSQL connection string. Free option: https://neon.tech
#   Neon -> New project -> Connection string (pick "Pooled connection")
# For AWS RDS use: postgresql://user:pass@xxx.rds.amazonaws.com:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Set to false only for AWS RDS (its certificate isn't in Node's default CA list).
DB_SSL_VERIFY=true

# Key the HoD/admin sends as the `x-admin-key` header to list submissions:
#   curl -H "x-admin-key: <key>" https://<api-url>/api/assessments
# Leave empty and the deploy script will generate one and print it.
# Generate yourself with:  openssl rand -hex 24
ADMIN_API_KEY=

# Extra allowed browser origins, comma separated (e.g. a custom domain).
# The deployed frontend URL is added automatically.
EXTRA_ALLOWED_ORIGINS=


# ------------------------------------------------------------------------------
# B. FREE DEPLOY  (scripts/deploy-free.sh)
#    Frontend -> Cloudflare Pages (free, no sleep)
#    API      -> Render free web service (sleeps after 15 min idle; first
#                request after that takes ~50 s while it wakes up)
#    Database -> Neon free Postgres (DATABASE_URL above)
# ------------------------------------------------------------------------------

# Render: https://dashboard.render.com -> Account settings -> API Keys -> Create.
# Render must also be able to read this GitHub repo. If the repo is private,
# connect GitHub once: Render dashboard -> New -> Web Service -> GitHub -> allow repo.
RENDER_API_KEY=

# Optional: Render workspace id (starts with "tea-" or "usr-"). Empty = your first workspace.
RENDER_OWNER_ID=

# Region closest to your users: singapore | oregon | ohio | virginia | frankfurt
RENDER_REGION=singapore

# Git repo + branch Render builds from. Empty = taken from `git remote origin`
# and your current branch. Push your commits before deploying.
GIT_REPO_URL=
DEPLOY_BRANCH=

# Cloudflare: https://dash.cloudflare.com/profile/api-tokens -> Create token ->
#   "Custom token" with permission  Account -> Cloudflare Pages -> Edit
CLOUDFLARE_API_TOKEN=
# Cloudflare dashboard -> any page -> right sidebar "Account ID"
CLOUDFLARE_ACCOUNT_ID=


# ------------------------------------------------------------------------------
# C. AWS DEPLOY  (scripts/deploy-aws.sh)  — NOT free, roughly US$5–25/month
#    Frontend -> S3 (private) + CloudFront
#    API      -> App Runner, container image in ECR
#    Database -> DATABASE_URL above (RDS or keep Neon)
#    Needs: aws CLI v2 and Docker on your machine.
# ------------------------------------------------------------------------------

# Credentials for an IAM user/role allowed to use ECR, App Runner, S3,
# CloudFront and IAM (to create the App Runner ECR-access role).
# Leave empty to use your existing `aws configure` profile instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# Mumbai is ap-south-1
AWS_REGION=ap-south-1

# App Runner size. Smallest: 0.25 vCPU / 0.5 GB.
APPRUNNER_CPU=0.25 vCPU
APPRUNNER_MEMORY=0.5 GB

# S3 bucket for the frontend. Must be globally unique. Empty = <APP_NAME>-web-<account id>
AWS_S3_BUCKET=
