# ==============================================================================
# JUIT Faculty Assessment & Lab Management System - Master Environment Variables
# ==============================================================================
# Instructions:
# 1. For Local Development: copy this to .env in your root directory.
# 2. For Vercel Frontend: set VITE_API_URL in Project Settings -> Environment Variables.
# 3. For Backend (Render / Railway / Koyeb): add all BACKEND & DATABASE variables.
# 4. For Free Cloud Database: Neon (neon.tech) or Supabase (supabase.com) provide free PostgreSQL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ------------------------------------------------------------------------------
# The public HTTPS URL where your backend API gateway is deployed (e.g. Render / Railway).
# Note: For Vite, variables exposed to the client MUST start with VITE_
VITE_API_URL=https://your-backend-gateway.onrender.com

# If using websockets in production:
# VITE_WS_URL=wss://your-backend-gateway.onrender.com


# ------------------------------------------------------------------------------
# 2. BACKEND / API GATEWAY CONFIGURATION (Render / Railway / Koyeb)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed frontend origins for CORS (include your Vercel domains)
# Example: https://your-project.vercel.app,http://localhost:5000,http://localhost:3000
ALLOWED_ORIGINS=https://your-app-name.vercel.app,http://localhost:5000,http://localhost:3000


# ------------------------------------------------------------------------------
# 3. INTERNAL MICROSERVICE URLS
# ------------------------------------------------------------------------------
# If running monolithic/combined on Render or via internal private networks (e.g., Railway):
AUTH_SERVICE_URL=http://localhost:8004
NOTIFICATION_SERVICE_URL=http://localhost:8005
PDF_SERVICE_URL=http://localhost:8006


# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (PostgreSQL - Free Cloud DB: Neon / Supabase)
# ------------------------------------------------------------------------------
# Hostname without 'https://' or port (e.g., ep-cool-leaf-12345.us-east-2.aws.neon.tech)
DB_HOST=your-neon-or-supabase-db-host.com
DB_PORT=5432
DB_USER=neondb_owner
DB_PASSWORD=your_secure_db_password
DB_NAME=neondb
DB_SSL=true

# Full connection string format (used by many cloud providers and ORMs):
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require


# ------------------------------------------------------------------------------
# 5. CACHE / REDIS (Upstash - upstash.com free serverless Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=your-upstash-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password


# ------------------------------------------------------------------------------
# 6. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate a strong 64-char key: `openssl rand -hex 32`
JWT_SECRET=generate_and_paste_a_secure_random_key_here
JWT_EXPIRY=24h

# Login sessions for the assessment form (handled by the API gateway, stored in
# the user_sessions table). Sessions slide forward while in use; idle ones expire.
# The gateway needs DATABASE_URL (or the DB_* vars above) to be set for login to work.
SESSION_TTL_DAYS=30


# ------------------------------------------------------------------------------
# 7. OBJECT STORAGE (PDFs / Files)
# ------------------------------------------------------------------------------
# Free tier options: Cloudflare R2, AWS S3 Free Tier, or Supabase Storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=faculty-assessments


# ------------------------------------------------------------------------------
# 8. EMAIL NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------
# Free Gmail App Password or Resend / SendGrid / Brevo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
